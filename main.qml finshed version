                }

                Canvas {
                    id: lidarScopeCanvas
                    anchors.fill: parent
                    anchors.leftMargin: 12
                    anchors.rightMargin: 12
                    anchors.topMargin: 36
                    anchors.bottomMargin: 12
                    antialiasing: true

                    property real sweepAngle: 0

                    NumberAnimation on sweepAngle {
                        from: 0
                        to: 360
                        duration: 2400
                        loops: Animation.Infinite
                        running: true
                    }

                    onSweepAngleChanged: requestPaint()
                    onWidthChanged: requestPaint()
                    onHeightChanged: requestPaint()
                    Component.onCompleted: requestPaint()

                    onPaint: {
                        var ctx = getContext("2d")
                        ctx.clearRect(0, 0, width, height)

                        var margin = 8
                        var left = margin
                        var top = margin
                        var scopeWidth = width - margin * 2
                        var scopeHeight = height - margin * 2
                        var centerX = left + scopeWidth / 2
                        var centerY = top + scopeHeight / 2

                        var stateColor = window.lockedOn
                                ? "#E61417"
                                : "#FAB900"

                        // Fyrkantig radargrund.
                        ctx.fillStyle = "rgba(5,18,27,0.95)"
                        ctx.fillRect(left, top, scopeWidth, scopeHeight)

                        ctx.strokeStyle = "rgba(145,155,155,0.50)"
                        ctx.lineWidth = 1
                        ctx.strokeRect(left, top, scopeWidth, scopeHeight)

                        // Rutnät.
                        ctx.strokeStyle = "rgba(145,155,155,0.20)"
                        ctx.lineWidth = 1

                        for (var gx = 1; gx < 8; ++gx) {
                            var gridX = left + scopeWidth * gx / 8
                            ctx.beginPath()
                            ctx.moveTo(gridX, top)
                            ctx.lineTo(gridX, top + scopeHeight)
                            ctx.stroke()
                        }

                        for (var gy = 1; gy < 6; ++gy) {
                            var gridY = top + scopeHeight * gy / 6
                            ctx.beginPath()
                            ctx.moveTo(left, gridY)
                            ctx.lineTo(left + scopeWidth, gridY)
                            ctx.stroke()
                        }

                        // Mittlinjer och mittpunkt.
                        ctx.strokeStyle = "rgba(237,242,244,0.48)"
                        ctx.lineWidth = 1

                        ctx.beginPath()
                        ctx.moveTo(centerX, top)
                        ctx.lineTo(centerX, top + scopeHeight)
                        ctx.stroke()

                        ctx.beginPath()
                        ctx.moveTo(left, centerY)
                        ctx.lineTo(left + scopeWidth, centerY)
                        ctx.stroke()

                        ctx.fillStyle = "#EDF2F4"
                        ctx.beginPath()
                        ctx.arc(centerX, centerY, 4, 0, Math.PI * 2)
                        ctx.fill()

                        ctx.strokeStyle = "#EDF2F4"
                        ctx.beginPath()
                        ctx.arc(centerX, centerY, 10, 0, Math.PI * 2)
                        ctx.stroke()

                        // Roterande radarsvep från mitten.
                        var angleRad =
                                (lidarScopeCanvas.sweepAngle - 90) *
                                Math.PI / 180
                        var dx = Math.cos(angleRad)
                        var dy = Math.sin(angleRad)
                        var edgeScale = Math.min(
                                    Math.abs(scopeWidth / 2 /
                                             (Math.abs(dx) < 0.0001
                                              ? 0.0001
                                              : dx)),
                                    Math.abs(scopeHeight / 2 /
                                             (Math.abs(dy) < 0.0001
                                              ? 0.0001
                                              : dy))
                                )
                        var sweepX = centerX + dx * edgeScale
                        var sweepY = centerY + dy * edgeScale

                        var gradient = ctx.createLinearGradient(
                                    centerX,
                                    centerY,
                                    sweepX,
                                    sweepY
                                )
                        gradient.addColorStop(
                                    0,
                                    "rgba(56,201,139,0.08)"
                                )
                        gradient.addColorStop(
                                    1,
                                    "rgba(56,201,139,0.80)"
                                )

                        ctx.strokeStyle = gradient
                        ctx.lineWidth = 2
                        ctx.beginPath()
                        ctx.moveTo(centerX, centerY)
                        ctx.lineTo(sweepX, sweepY)
                        ctx.stroke()

                        // Kameramålet blir radarpricken.
                        var frameWidth = Math.max(
                                    1,
                                    window.targetFrameWidth
                                )
                        var frameHeight = Math.max(
                                    1,
                                    window.targetFrameHeight
                                )

                        var targetAvailable =
                                window.targetX > 0 ||
                                window.targetY > 0

                        if (targetAvailable) {
                            var normalizedX = Math.max(
                                        0,
                                        Math.min(
                                            1,
                                            window.targetX / frameWidth
                                        )
                                    )
                            var normalizedY = Math.max(
                                        0,
                                        Math.min(
                                            1,
                                            window.targetY / frameHeight
                                        )
                                    )

                            var dotX = left +
                                    normalizedX * scopeWidth
                            var dotY = top +
                                    normalizedY * scopeHeight

                            // Linje från radarcentrum till målet.
                            ctx.strokeStyle = window.lockedOn
                                    ? "rgba(230,20,23,0.55)"
                                    : "rgba(250,185,0,0.45)"
                            ctx.lineWidth = 1
                            ctx.beginPath()
                            ctx.moveTo(centerX, centerY)
                            ctx.lineTo(dotX, dotY)
                            ctx.stroke()

                            // Målprick och ring.
                            ctx.fillStyle = stateColor
                            ctx.beginPath()
                            ctx.arc(dotX, dotY, 7, 0, Math.PI * 2)
                            ctx.fill()

                            ctx.strokeStyle = "#EDF2F4"
                            ctx.lineWidth = 1.5
                            ctx.beginPath()
                            ctx.arc(dotX, dotY, 13, 0, Math.PI * 2)
                            ctx.stroke()

                            // Kort siktskors runt målpricken.
                            ctx.strokeStyle = stateColor
                            ctx.lineWidth = 1.5
                            ctx.beginPath()
                            ctx.moveTo(dotX - 18, dotY)
                            ctx.lineTo(dotX - 10, dotY)
                            ctx.moveTo(dotX + 10, dotY)
                            ctx.lineTo(dotX + 18, dotY)
                            ctx.moveTo(dotX, dotY - 18)
                            ctx.lineTo(dotX, dotY - 10)
                            ctx.moveTo(dotX, dotY + 10)
                            ctx.lineTo(dotX, dotY + 18)
                            ctx.stroke()
                        }

                        ctx.fillStyle = "rgba(237,242,244,0.70)"
                        ctx.font = "10px sans-serif"
                        ctx.textAlign = "left"
                        ctx.fillText("CAMERA TARGET RADAR", left + 7, top + 15)

                        ctx.textAlign = "right"
                        ctx.fillText(
                                    window.lockedOn
                                    ? "LOCK"
                                    : "SCAN",
                                    left + scopeWidth - 7,
                                    top + 15
                                )
                    }

                    Connections {
                        target: window

                        function onTargetXChanged() {
                            lidarScopeCanvas.requestPaint()
                        }

                        function onTargetYChanged() {
                            lidarScopeCanvas.requestPaint()
                        }

