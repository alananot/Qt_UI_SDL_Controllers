    SdlHelper {
        id: sdl
        property bool locked: false
        onButtonPressed: {
            // Y får bara växla GAS/SERVO på huvudskärmen.
            // I DEBUG och GUIDE ignoreras Y helt.
            if (button === 3 &&
                (debugScreen.visible || tutorial.visible)) {
                window.y = 0
                window.yButtonHeld = false
                yReleasePulseTimer.stop()
                console.log("Y ignored while DEBUG or GUIDE is open")
                return
            }

            reset_idle()
            if (status == "Intro") {
                if (!window.networkEnabled) {
                    window.everOperative = true
                    window.status = "Offline"
                    window.isidle = false
                    fadeoutintro.visible = false
                    hudIntro.visible = false
                    turretItem.opacity = 1.0
                    return
                }

                if (locked) return
                locked = true
                intro_lamp.color = "yellow"
                intro_text.text = "Trying to Connect"
                client.connectToHost("192.168.4.1", 2222)
                tcpGraph.connectToHost("192.168.4.1", 2223)
                tcpButtons.connectToHost("192.168.4.1", 2224)
                tcpJoystick.connectToHost("192.168.4.1", 2225)
                status = "Operative"
                client.sendMessage(status)
                lockTimer.start()
            }
            else if(status !== "Intro" && status != "idle") {
                switch(button) {
                case 0:
                    a = 1
                    if(!autonomous)
                    {
                        autonomous = true
                    }
                    else
                    {
                        autonomous = false
                    }

                    window.sendUnlock()
                    break
                case 1: b = 1; break
                case 2: x = 1; break
                case 3:
                    if (debugScreen.visible || tutorial.visible) {
                        y = 0
                        window.yButtonHeld = false
                        break
                    }

                    y = 1

                    var now = Date.now()


                    if (!window.yButtonHeld &&
                        now - window.lastYToggleAt > 350) {

                        window.yButtonHeld = true
                        window.lastYToggleAt = now

                        // Från och med nu styr endast Y vad UI:t visar.
                        window.firingModeLocalControl = true
                        window.gasMode = !window.gasMode
                        window.requestedGasMode = window.gasMode
                        window.firingModeKnown = true
                        window.firingModePending = false

                        firingModeReplyTimeout.stop()
                        yReleasePulseTimer.restart()

                        console.log(
                            "Y changed UI immediately:",
                            window.gasMode ? "GAS" : "SERVO"
                        )
                    }
                    break
                case 9:
                    shoulder_l = 1

                    if (!window.l1ButtonHeld) {
                        window.l1ButtonHeld = true
                        window.requestAmmunitionAction("reload")
                    }
                    break

                case 10:
                    shoulder_r = 1

                    if (!window.r1ButtonHeld) {
                        window.r1ButtonHeld = true
                        window.requestAmmunitionAction("fire")
                    }
                    break
                }
                window.sendButtonState()
            }
        }
        onButtonReleased: {
            // Inget Y-releasepaket skickas från DEBUG eller GUIDE.
            if (button === 3 &&
                (debugScreen.visible || tutorial.visible)) {
                window.y = 0
                window.yButtonHeld = false
                yReleasePulseTimer.stop()
                return
            }

            if (status !== "Intro" && status != "idle") {
                switch(button) {
                case 0: a = 0; break
                case 1: b = 0; break
                case 2: x = 0; break
                case 3:
                    y = 0
                    window.yButtonHeld = false
                    break
                case 9:
                    shoulder_l = 0
                    window.l1ButtonHeld = false
                    break

                case 10:
                    shoulder_r = 0
                    window.r1ButtonHeld = false
                    break
                }
                window.sendButtonState()
            }
        }
        onAxisMoved: {
