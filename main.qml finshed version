    function sendUnlock() {
        if (!window.networkEnabled)
            return

        var xhr = new XMLHttpRequest()
        xhr.open("POST", "http://192.168.4.200:8080/unlock")
        xhr.send()
    }


    function setCameraIdle(idleState) {
        if (!window.networkEnabled) {
            window.cameraServerActive = false
            window.cameraCommandPending = false
            return
        }

        // Kameraservern och kamerabilden ska fortsätta vara aktiva i IDLE.
        // Endpointen anropas fortfarande för kompatibilitet med servern.
        window.cameraCommandPending = true

        var xhr = new XMLHttpRequest()
        var endpoint = idleState ? "/camera/idle" : "/camera/connect"

        xhr.onreadystatechange = function() {
            if (xhr.readyState !== XMLHttpRequest.DONE)
                return

            window.cameraCommandPending = false

            if (xhr.status === 200) {
                window.cameraServerActive = true
                feedTimer.waitingForLoad = false
            } else {
                window.cameraServerActive = false
                cameraConnectRetry.restart()
            }
        }

        xhr.open(
            "POST",
            "http://192.168.4.200:8080" + endpoint,
            true
        )
        xhr.send()
    }

    Timer {
        id: cameraConnectRetry
        interval: 500
        repeat: false
        onTriggered: {
            if (window.networkEnabled &&
                !window.isidle &&
                !window.cameraServerActive)
                window.setCameraIdle(false)
        }
    }

    Timer {
        interval: 80
        running: window.networkEnabled &&
                 !window.isidle &&
                 window.cameraServerActive
        repeat: true
        onTriggered: {
            var xhr = new XMLHttpRequest()
            xhr.open("GET", "http://192.168.4.200:8080/status")
            xhr.onreadystatechange = function() {
                if (xhr.readyState === XMLHttpRequest.DONE && xhr.status === 200) {
                    var data = JSON.parse(xhr.responseText)

                    window.lockedOn =
                            data.locked === true ||
                            data.locked === 1 ||
                            String(data.locked).toLowerCase() === "true"

                    var rawX = data.cx !== undefined
                               ? data.cx
                               : (data.target_x !== undefined
                                  ? data.target_x
                                  : data.x)

                    var rawY = data.cy !== undefined
                               ? data.cy
                               : (data.target_y !== undefined
                                  ? data.target_y
                                  : data.y)

                    var parsedX = Number(rawX)
                    var parsedY = Number(rawY)

                    if (isFinite(parsedX))
                        window.targetX = Math.round(parsedX)

                    if (isFinite(parsedY))
                        window.targetY = Math.round(parsedY)

                    var frameWidth = Number(
                                data.frame_width !== undefined
                                ? data.frame_width
                                : (data.image_width !== undefined
                                   ? data.image_width
                                   : data.width)
                            )

                    var frameHeight = Number(
                                data.frame_height !== undefined
                                ? data.frame_height
                                : (data.image_height !== undefined
                                   ? data.image_height
                                   : data.height)
                            )

                    if (isFinite(frameWidth) && frameWidth > 1)
                        window.targetFrameWidth = Math.round(frameWidth)

                    if (isFinite(frameHeight) && frameHeight > 1)
                        window.targetFrameHeight = Math.round(frameHeight)
                }
            }
            xhr.send()
        }
    }


    function readLidarDistance() {
        if (!window.networkEnabled)
            return

        // Samma villkor som den tidigare distanslösningen:
        // systemet, kameran och target lock måste vara aktiva.
        var systemConnected =
                window.status === "Operative" &&
                !window.isidle &&
                window.cameraServerActive

        if (!systemConnected || !window.lockedOn) {
            window.lidarConnected = false
            window.lidarValid = false
            window.lidarDistanceMm = 0
            window.lidarDistanceM = 0.0
            window.lidarStatus = 0
            window.lidarSource = "WAITING"
            window.lidarMessage = systemConnected
                    ? "WAITING FOR LOCK"
                    : "WAITING FOR CONNECTION"
            return
        }

        if (window.lidarRequestPending)
            return

        window.lidarRequestPending = true
        window.lidarRequestStartedAt = Date.now()
        window.lidarRequestCount += 1

        var xhr = new XMLHttpRequest()
        window.lidarActiveRequest = xhr

        xhr.onreadystatechange = function() {
            if (xhr.readyState !== XMLHttpRequest.DONE)
                return

            window.lidarRequestPending = false
            window.lidarActiveRequest = null
            window.lidarHttpStatus = xhr.status

            if (xhr.status !== 200) {
                window.lidarConnected = false
                window.lidarValid = false
                window.lidarSource = "WAITING"
                window.lidarMessage = "NO CONNECTION"
                return
            }

            try {
                var data = JSON.parse(xhr.responseText)

                // Stödjer samma gamla serverformat:
                // {"distance_mm": 4200, "valid": true}
                // eller {"distance_m": 4.2, "valid": true}
                var distanceMm = Number(
                            data.distance_mm !== undefined
                            ? data.distance_mm
                            : Number(data.distance_m) * 1000.0
                        )

                var statusValue = Number(data.status)

                window.lidarConnected = true
                window.lidarStatus = isFinite(statusValue)
                                     ? statusValue
                                     : 1

                window.lidarValid =
                        data.valid !== false &&
                        isFinite(distanceMm) &&
                        distanceMm >= 0

                if (window.lidarValid) {
                    window.lidarDistanceMm = Math.round(distanceMm)
                    window.lidarDistanceM =
                            window.lidarDistanceMm / 1000.0
                    window.lidarSource = "HTTP SENSOR"
                    window.lidarMessage = "DISTANCE ONLINE"
                } else {
                    window.lidarDistanceMm = 0
                    window.lidarDistanceM = 0.0
                    window.lidarMessage = "INVALID DISTANCE"
                }
            } catch (error) {
                window.lidarConnected = false
                window.lidarValid = false
                window.lidarSource = "WAITING"
                window.lidarMessage = "JSON ERROR"
            }
        }

        xhr.open(
            "GET",
            window.lidarUrl + "?t=" + Date.now(),
            true
        )
        xhr.send()
    }

    // Fyra distansavläsningar per sekund, precis som tidigare.
    Timer {
        id: lidarTimer
        interval: 250
        running: window.networkEnabled &&
                 window.status === "Operative" &&
                 !window.isidle &&
                 window.cameraServerActive
        repeat: true
        triggeredOnStart: true
        onTriggered: window.readLidarDistance()
    }

    // Avbryt ett fastnat HTTP-anrop efter en sekund.
    Timer {
        id: lidarTimeoutTimer
        interval: 100
        running: window.networkEnabled
        repeat: true

        onTriggered: {
            if (!window.lidarRequestPending)
                return

            if (Date.now() - window.lidarRequestStartedAt < 1000)
                return

            var request = window.lidarActiveRequest
            window.lidarActiveRequest = null
            window.lidarRequestPending = false
            window.lidarConnected = false
            window.lidarValid = false
            window.lidarSource = "WAITING"
            window.lidarMessage = "LIDAR TIMEOUT"

            if (request !== null) {
                try {
                    request.abort()
                } catch (error) {
                }
            }
        }
    }

    TcpClient {
        id: tcpGraph
        property string network: ""
        onConnected: console.log("Connected to server")
        onMessageRecieved: {

            network += msg
            if(network.indexOf("\n") !== -1){
                let cleanValue = network.replace("\r","").replace("\n","")
                let values = cleanValue.split(",")
                for(let i = 0; i < values.length; i++)

                {
                     let val = parseFloat(values[i].trim())
                    switch(i)
                    {
                    case 0:
                        socketValue = val
                        break;

                    case 1:
                        socketValue2 = val
                        break;
                    case 2:
                        socketValue3 = val
                        break;
                    case 3:
                        socketValue4 = val
                        break;
                    case 4:
                        socketValue5 = val
                        break;
                    case 5:
