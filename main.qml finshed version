    Timer { id: lockTimer; interval: 1500; repeat: false; onTriggered: sdl.locked = false }

    Timer {
        id: yReleasePulseTimer
        interval: 70
        repeat: false

        onTriggered: {
            window.y = 0
            window.sendButtonState()
        }
    }

    Timer {
        id: firingModeReplyTimeout
        interval: 1500
        repeat: false

        onTriggered: {
            if (!window.firingModePending)
                return

            window.firingModePending = false
            console.warn(
                "No immediate GAS/SERVO confirmation; keeping requested mode:",
                window.gasMode ? "GAS" : "SERVO"
            )
        }
    }

    Timer {
        id: is_idle_time
        interval: 30000
        repeat: false
        onTriggered: enterIdle()
    }

    Timer {
        id: idle
        interval: 100
        repeat: true
        onTriggered: {
            if (window.networkEnabled)
                client.sendMessage("idle")
        }
    }

    Timer {
        id: moved_timer
        interval: 1
        repeat: true
        onTriggered: {
            if (window.networkEnabled) {
                tcpJoystick.sendMessage(
                            x1_movement + "," +
                            y1_movement + "," +
                            x2_movement + "," +
                            y2_movement + "," +
                            right_trig + "," +
                            left_trig
                        )
            }
        }
    }

    function enterIdle() {
        if (!window.networkEnabled)
            return

        if (status != "Intro" && status != "error" && !autonomous) {
            status = "idle"
            window.isidle = true
            status_light.color = "white"
            window.setCameraIdle(true)
            idle.start()
        }
    }

    function reset_idle() {
        var wasIdle = window.isidle
        window.isidle = false

        if (wasIdle) {
            status = "Operative"
            window.setCameraIdle(false)
        }

        if (status != "Intro" && status != "error") {
            status_light.color = "green"
        } else if (status == "error") {
            status_light.color = "red"
        } else {
            status_light.color = "yellow"
        }
        if (window.networkEnabled)
            client.sendMessage(status)

        idle.stop()
        is_idle_time.restart()
    }
