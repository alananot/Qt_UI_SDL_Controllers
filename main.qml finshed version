    function ammunitionCount() {
        return (window.mLeft ? 1 : 0) +
               (window.mMid ? 1 : 0) +
               (window.mRight ? 1 : 0)
    }

    function setAmmunitionCount(count) {
        var safeCount = Math.max(
                    0,
                    Math.min(3, Math.round(Number(count)))
                )

        // Ammunitionen fylls alltid från vänster till höger.
        window.mLeft = safeCount >= 1
        window.mMid = safeCount >= 2
        window.mRight = safeCount >= 3

        console.log(
            "Ammunition state:",
            window.mLeft ? 1 : 0,
            window.mMid ? 1 : 0,
            window.mRight ? 1 : 0
        )
    }

    function setAmmunitionState(leftLoaded, midLoaded, rightLoaded) {
        window.mLeft = leftLoaded === true || Number(leftLoaded) === 1
        window.mMid = midLoaded === true || Number(midLoaded) === 1
        window.mRight = rightLoaded === true || Number(rightLoaded) === 1

        console.log(
            "Ammunition state from server:",
            window.mLeft ? 1 : 0,
            window.mMid ? 1 : 0,
            window.mRight ? 1 : 0
        )
    }

    function consumeNextMissile() {
        // Skjutordning: vänster -> mitten -> höger.
        if (window.mLeft) {
            window.mLeft = false
            return true
        }

        if (window.mMid) {
            window.mMid = false
            return true
        }

        if (window.mRight) {
            window.mRight = false
            return true
        }

        console.log("R1: no missile available")
        return false
    }

    function reloadNextMissile() {
        // Laddordning: höger -> mitten -> vänster.
        // Exakt en missil laddas per L1-tryck.
        if (!window.mRight) {
            window.mRight = true
            return true
        }

        if (!window.mMid) {
            window.mMid = true
            return true
        }

        if (!window.mLeft) {
            window.mLeft = true
            return true
        }

        console.log("L1: all missile slots are already loaded")
        return false
    }

    function requestAmmunitionAction(action) {
        var changed = false

        if (action === "fire")
            changed = window.consumeNextMissile()
        else if (action === "reload")
            changed = window.reloadNextMissile()

        if (!changed)
            return false

        if (action === "reload")
            window.ammunitionActivatedByUser = true

        // UI ändras direkt. Serverns onMessageRecieved används sedan
        // för bekräftelse eller för att skriva in ett explicit serverläge.
        window.ammoPendingAction = action
        window.ammoPendingUntil = Date.now() + 3000

        console.log(
            "Local ammunition action:",
            action,
            "remaining:",
            window.ammunitionCount()
        )

        return true
    }

    function applyServerAmmunitionEvent(action) {
        var now = Date.now()

        // Serverns svar på den knapp vi precis hanterade lokalt ska endast
        // bekräfta händelsen, inte ta bort/ladda ännu en missil.
        if (window.ammoPendingAction === action &&
            now <= window.ammoPendingUntil) {

            window.ammoPendingAction = ""
            window.ammoPendingUntil = 0
            window.lastAmmoServerEvent = action
            window.lastAmmoServerEventAt = now

            console.log("Server confirmed ammunition action:", action)
            return true
        }

        // Skydd om samma serversvar råkar skickas på två TCP-anslutningar.
        if (window.lastAmmoServerEvent === action &&
            now - window.lastAmmoServerEventAt < 350) {

            console.log("Ignoring duplicate ammunition event:", action)
            return true
        }

        window.lastAmmoServerEvent = action
        window.lastAmmoServerEventAt = now

        if (action === "fire")
            return window.consumeNextMissile()

        if (action === "reload") {
            if (!window.ammunitionActivatedByUser) {
                console.log(
                    "Ignoring server reload before user pressed L1"
                )
                return true
            }

            return window.reloadNextMissile()
        }

        return false
    }

    function applyAmmunitionMessage(rawMessage) {
        if (rawMessage === undefined || rawMessage === null)
            return false

        var message = String(rawMessage).trim().toLowerCase()

        if (message.length === 0)
            return false

        // Explicita tillstånd som servern kan skicka:
        // ammo:1,1,0
        // ammunition=[1,1,0]
        // missiles=1;0;0
        var stateMatch = message.match(
                    /(?:ammo|ammunition|missiles?|munition)["']?\s*[:=]\s*\[?\s*([01])\s*(?:[,;|]\s*|\s+)([01])\s*(?:[,;|]\s*|\s+)([01])/
                )

        if (stateMatch !== null) {
            if (!window.ammunitionActivatedByUser) {
                console.log(
                    "Ignoring initial server ammunition state; " +
                    "waiting for user L1 reload"
                )
                return true
            }

            window.setAmmunitionState(
                        Number(stateMatch[1]),
                        Number(stateMatch[2]),
                        Number(stateMatch[3])
                    )

            window.ammoPendingAction = ""
            window.ammoPendingUntil = 0
            return true
        }

        // Servern kan även skicka endast antalet:
        // ammo:3, ammo=2, missiles:0
        var countMatch = message.match(
                    /(?:ammo|ammunition|missiles?|munition)["']?\s*[:=]\s*([0-3])(?:\s*$|\s*[^,;|0-9])/
                )

        if (countMatch !== null) {
            if (!window.ammunitionActivatedByUser) {
                console.log(
                    "Ignoring initial server ammunition count; " +
                    "waiting for user L1 reload"
                )
                return true
            }

            window.setAmmunitionCount(Number(countMatch[1]))
            window.ammoPendingAction = ""
            window.ammoPendingUntil = 0
            return true
        }

        // Om servern ekar knapp-paketet:
        // a,b,x,y,L1,R1
        var buttonMatch = message.match(
                    /^\s*([01])\s*,\s*([01])\s*,\s*([01])\s*,\s*([01])\s*,\s*([01])\s*,\s*([01])\s*$/
                )

        if (buttonMatch !== null) {
            var serverL1 = Number(buttonMatch[5])
            var serverR1 = Number(buttonMatch[6])

            if (serverL1 === 1 && window.lastServerShoulderL === 0)
                window.applyServerAmmunitionEvent("reload")

            if (serverR1 === 1 && window.lastServerShoulderR === 0)
                window.applyServerAmmunitionEvent("fire")

            window.lastServerShoulderL = serverL1
            window.lastServerShoulderR = serverR1
            return true
        }

        // Textbaserade svar som också accepteras:
        // shot, fired, fire, shoot, r1
        // reload, reloaded, loaded, load, l1
        var isFire =
                message.indexOf("shot") !== -1 ||
                message.indexOf("fired") !== -1 ||
                /(^|[^a-z])fire([^a-z]|$)/.test(message) ||
                /(^|[^a-z])shoot([^a-z]|$)/.test(message) ||
                /(^|[^a-z])r1([^a-z]|$)/.test(message)

        var isReload =
                message.indexOf("reloaded") !== -1 ||
                /(^|[^a-z])reload([^a-z]|$)/.test(message) ||
                /(^|[^a-z])loaded([^a-z]|$)/.test(message) ||
                /(^|[^a-z])load([^a-z]|$)/.test(message) ||
                /(^|[^a-z])l1([^a-z]|$)/.test(message)

        if (isFire && !isReload)
            return window.applyServerAmmunitionEvent("fire")

        if (isReload && !isFire)
            return window.applyServerAmmunitionEvent("reload")

        return false
    }

    function handleAmmunitionData(receiver, rawData) {
        if (rawData === undefined || rawData === null)
            return

        var incoming = String(rawData)

        // Vanliga kompletta svar utan radslut hanteras direkt.
        if (window.applyAmmunitionMessage(incoming))
            return

        receiver.ammoBuffer += incoming

        var normalized = receiver.ammoBuffer.replace(/\r/g, "\n")
        var messages = normalized.split("\n")
        receiver.ammoBuffer = messages.pop()

        for (var i = 0; i < messages.length; ++i)
            window.applyAmmunitionMessage(messages[i])

        // Stöd även TCP-svar som delats upp utan radslut.
        if (window.applyAmmunitionMessage(receiver.ammoBuffer))
            receiver.ammoBuffer = ""

        if (receiver.ammoBuffer.length > 256)
            receiver.ammoBuffer = ""
    }

    // Tar emot serverns verkliga GAS/SERVO-läge.
    // Funktionen accepterar till exempel:
    // gas, servo, mode:gas, mode=servo, firing:gas, firing=servo
    function applyFiringModeMessage(rawMessage) {
        if (rawMessage === undefined || rawMessage === null)
            return false

        var message = String(rawMessage).trim().toLowerCase()

        if (message.length === 0)
            return false

        var containsServo =
                /(^|[^a-z])servo([^a-z]|$)/.test(message)
        var containsGas =
                /(^|[^a-z])gas([^a-z]|$)/.test(message)

        // Acceptera bara ett tydligt läge.
        if (containsServo === containsGas)
            return false

        var serverGasMode = containsGas

        // Efter första Y-trycket får servern inte skriva över UI-läget.
        // Serverns svar kan komma ett knapptryck för sent och innehålla
        // föregående läge. Det var orsaken till att bilden hoppade först
        // när en annan knapp trycktes.
        if (window.firingModeLocalControl) {
            if (serverGasMode === window.requestedGasMode) {
                window.firingModePending = false
                firingModeReplyTimeout.stop()

                console.log(
                    "Server confirmed local firing mode:",
                    serverGasMode ? "GAS" : "SERVO"
                )
            } else {
                console.log(
                    "Ignoring stale server firing mode:",
                    serverGasMode ? "GAS" : "SERVO",
                    "- UI remains:",
                    window.gasMode ? "GAS" : "SERVO"
                )
            }

            return true
        }

        // Före första Y-trycket används serverns meddelande som startläge.
        window.gasMode = serverGasMode
        window.requestedGasMode = serverGasMode
        window.firingModeKnown = true
        window.firingModePending = false
        firingModeReplyTimeout.stop()

        console.log(
            "Initial firing mode from server:",
            window.gasMode ? "GAS" : "SERVO"
        )

        return true
    }

    // TCP kan dela ett meddelande i flera delar eller slå ihop flera
    // meddelanden. Den här funktionen buffrar därför inkommande data.
    function handleFiringModeData(receiver, rawData) {
        if (rawData === undefined || rawData === null)
            return

        receiver.modeBuffer += String(rawData)

        // Hantera både \n och \r som radslut.
        var normalized = receiver.modeBuffer.replace(/\r/g, "\n")
        var messages = normalized.split("\n")

        // Sista delen kan vara ett ofullständigt TCP-meddelande.
        receiver.modeBuffer = messages.pop()

        for (var i = 0; i < messages.length; ++i)
            window.applyFiringModeMessage(messages[i])

        // Vissa servrar skickar utan radslut. Försök då tolka bufferten
        // direkt, men rensa den bara när ett komplett läge hittades.
        if (window.applyFiringModeMessage(receiver.modeBuffer))
            receiver.modeBuffer = ""

        // Skydd mot att okänd data växer obegränsat.
        if (receiver.modeBuffer.length > 256)
            receiver.modeBuffer = ""
    }

    function buttonPacket() {
        // TCP har inga automatiska meddelandegränser. Radslutet gör att
        // varje knappstatus blir ett separat paket för serverns parser.
        return a + "," + b + "," + x + "," + y + "," +
               shoulder_l + "," + shoulder_r + "\n"
    }

